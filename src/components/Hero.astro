---
import groupPeople from '../assets/group-people.jpg';
import illustrationPeople from '../assets/illustration-people.jpg';
---

<section class="hero" id="home">
  <!-- ===== ANIMATED SHAPE CANVAS ===== -->
  <div class="hero__canvas" aria-hidden="true">
    <!-- Big squares (dominant) -->
    <div class="sh sh--square sh--lavender sh--huge sh--pos-1"></div>
    <div class="sh sh--square sh--mint sh--xl sh--pos-2"></div>
    <div class="sh sh--square sh--softpink sh--lg sh--pos-3"></div>
    <div class="sh sh--square sh--softyellow sh--xl sh--pos-4"></div>
    <div class="sh sh--square sh--softblue sh--md sh--pos-5"></div>
    <div class="sh sh--square-stroke sh--xxl sh--pos-6"></div>

    <!-- A couple of circles for variety -->
    <div class="sh sh--ring sh--lg sh--pos-7"></div>
    <div class="sh sh--circle sh--softcoral sh--md sh--pos-8"></div>

    <!-- Small accent squares -->
    <div class="sh sh--square sh--lavender sh--sm sh--pos-9"></div>
    <div class="sh sh--square sh--mint sh--xs sh--pos-10"></div>
    <div class="sh sh--square sh--softyellow sh--xs sh--pos-11"></div>

    <!-- Dots -->
    <div class="sh sh--dot sh--pos-d1"></div>
    <div class="sh sh--dot sh--pos-d2"></div>
    <div class="sh sh--dot sh--pos-d3"></div>
    <div class="sh sh--dot sh--pos-d4"></div>
    <div class="sh sh--dot sh--pos-d5"></div>

    <!-- Symbols -->
    <span class="sh sh--sym sh--pos-s1">✦</span>
    <span class="sh sh--sym sh--pos-s2">✦</span>
    <span class="sh sh--sym sh--pos-s3">○</span>
  </div>

  <!-- ===== CONTENT ===== -->
  <div class="hero__content container">
    <div class="hero__grid">
      <!-- Left: Text -->
      <div class="hero__text">
        <h1 class="hero__name">. SOMA .</h1>
        <p class="hero__tagline">
          Cuerpo, arte y encuentro.
        </p>

        <p class="hero__desc">
          Un espacio vivo donde la creatividad se comparte. 
          Talleres, encuentros y procesos creativos donde se cruzan movimiento, arte y comunidad.
        </p>

        <div class="hero__keywords">
          <span class="hero__kw">talleres</span>
          <span class="hero__kw-sep">·</span>
          <span class="hero__kw">movimiento</span>
          <span class="hero__kw-sep">·</span>
          <span class="hero__kw">arte</span>
          <span class="hero__kw-sep">·</span>
          <span class="hero__kw">comunidad</span>
        </div>

        <div class="hero__actions">
          <a href="#events" class="btn btn--coral">Ver agenda →</a>
          <a href="#about" class="btn btn--outline">Descubre Soma</a>
        </div>
      </div>

      <!-- Right: Images stacked -->
      <div class="hero__visuals">
        <div class="hero__img-stack">
          <!-- Main image: group-people in a square frame -->
          <div class="hero__img-frame hero__img-frame--main">
            <img src={groupPeople.src} alt="Comunidad Soma — personas, encuentros y creatividad" loading="eager" />
          </div>

          <!-- Illustration below, anchored -->
          <div class="hero__img-frame hero__img-frame--bottom">
            <img src={illustrationPeople.src} alt="Ilustración de personas diversas" loading="eager" />
          </div>
        </div>

        <!-- Decorative squares near images -->
        <div class="hero__img-deco hero__img-deco--1" aria-hidden="true"></div>
        <div class="hero__img-deco hero__img-deco--2" aria-hidden="true"></div>
        <div class="hero__img-deco hero__img-deco--3" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  /* ===== GRID LAYOUT ===== */
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
  }

  /* ===== TEXT SIDE ===== */
  .hero__text {
    position: relative;
    z-index: 2;
  }

  .hero__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 0.8rem;
    color: var(--ink);
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    margin-bottom: 1.5rem;
    line-height: 1.3;
    letter-spacing: 0.01em;
    opacity: 0.75;
  }

  .hero__desc {
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    opacity: 0.55;
    margin-bottom: 1.8rem;
    max-width: 420px;
    line-height: 1.7;
  }

  .hero__keywords {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.2rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.4;
  }

  .hero__kw-sep {
    opacity: 0.4;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ===== VISUALS SIDE ===== */
  .hero__visuals {
    position: relative;
    z-index: 2;
  }

  .hero__img-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Image frames — square with ink borders */
  .hero__img-frame {
    overflow: hidden;
    border: 2.5px solid var(--ink);
    box-shadow: var(--shadow);
    border-radius: var(--radius);
    position: relative;
    background: var(--cream);
  }

  .hero__img-frame img {
    width: 100%;
    display: block;
  }

  /* Main frame — group-people (square) */
  .hero__img-frame--main {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
  }

  .hero__img-frame--main img {
    height: 100%;
    object-fit: cover;
    /* Slight warmth to harmonize pastel illustration with our palette */
    filter: saturate(1.1) brightness(1.02);
  }

  /* Bottom frame — illustration (strip, not floating) */
  .hero__img-frame--bottom {
    width: 100%;
    max-width: 420px;
    box-shadow: var(--shadow-sm);
  }

  .hero__img-frame--bottom img {
    height: auto;
    object-fit: contain;
    padding: 0.8rem 1rem;
  }

  /* Decorative squares near images */
  .hero__img-deco {
    position: absolute;
    border: 2.5px solid var(--ink);
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  .hero__img-deco--1 {
    width: 65px;
    height: 65px;
    background: #FFD166;
    top: -18px;
    right: -18px;
    animation: wobble 8s ease-in-out infinite;
    transform: rotate(12deg);
  }

  .hero__img-deco--2 {
    width: 40px;
    height: 40px;
    background: #FF5C38;
    bottom: 80px;
    left: -22px;
    animation: wobble 10s ease-in-out infinite 1.5s;
    transform: rotate(-8deg);
  }

  .hero__img-deco--3 {
    width: 28px;
    height: 28px;
    background: #9B5DE5;
    bottom: -12px;
    right: 60px;
    border-radius: 50%;
    animation: pop 5s ease-in-out infinite 1s;
  }

  /* ===== SHAPE CANVAS ===== */
  .hero__canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* --- BASE SHAPES --- */
  .sh {
    position: absolute;
    will-change: transform;
  }

  .sh--square {
    border-radius: var(--radius-sm);
    border: 2.5px solid var(--ink);
  }

  .sh--square-stroke {
    border-radius: var(--radius-sm);
    border: 2.5px solid var(--ink);
    background: none;
  }

  .sh--circle {
    border-radius: 50%;
    border: 2.5px solid var(--ink);
  }

  .sh--ring {
    border-radius: 50%;
    background: none !important;
    border: 2.5px solid var(--ink);
  }

  .sh--dot {
    border-radius: 50%;
    width: 12px;
    height: 12px;
    border: 2px solid var(--ink);
    background: var(--ink);
  }

  .sh--sym {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
  }

  /* --- SIZES --- */
  .sh--huge { width: 300px; height: 300px; }
  .sh--xxl { width: 240px; height: 240px; }
  .sh--xl { width: 180px; height: 180px; }
  .sh--lg { width: 120px; height: 120px; }
  .sh--md { width: 80px; height: 80px; }
  .sh--sm { width: 50px; height: 50px; }
  .sh--xs { width: 30px; height: 30px; }

  /* --- PASTEL COLORS (harmonize with group-people illustration) --- */
  .sh--lavender { background: #D5CCE8; }
  .sh--mint { background: #C5E8D5; }
  .sh--softpink { background: #F0C8D4; }
  .sh--softyellow { background: #F5E6B8; }
  .sh--softblue { background: #C8D8F0; }
  .sh--softcoral { background: #F0C4B8; }

  /* --- POSITIONS & ANIMATIONS --- */

  /* Big lavender square — top-left, slightly rotated */
  .sh--pos-1 {
    top: -60px;
    left: -80px;
    opacity: 0.4;
    animation: drift-sq-1 12s ease-in-out infinite;
    transform: rotate(-8deg);
  }

  /* Mint square — right center area */
  .sh--pos-2 {
    top: 8%;
    right: -50px;
    opacity: 0.3;
    animation: drift-sq-2 15s ease-in-out infinite;
    transform: rotate(5deg);
  }

  /* Soft pink square — bottom left */
  .sh--pos-3 {
    bottom: 5%;
    left: 8%;
    opacity: 0.35;
    animation: wobble 10s ease-in-out infinite;
    transform: rotate(12deg);
  }

  /* Soft yellow square — bottom right */
  .sh--pos-4 {
    bottom: -40px;
    right: 15%;
    opacity: 0.3;
    animation: drift-sq-1 14s ease-in-out infinite 2s;
    transform: rotate(-5deg);
  }

  /* Soft blue square (medium) — upper left area */
  .sh--pos-5 {
    top: 22%;
    left: 35%;
    opacity: 0.25;
    animation: drift-sq-2 11s ease-in-out infinite 1s;
    transform: rotate(20deg);
  }

  /* Big ink-stroke square — center, very subtle */
  .sh--pos-6 {
    top: 30%;
    left: -30px;
    opacity: 0.06;
    animation: spin-slow 80s linear infinite;
  }

  /* Ring circle — top right area */
  .sh--pos-7 {
    top: 5%;
    right: 25%;
    opacity: 0.08;
    animation: spin-slow 50s linear infinite reverse;
  }

  /* Soft coral circle — bottom center */
  .sh--pos-8 {
    bottom: 15%;
    left: 45%;
    opacity: 0.3;
    animation: drift-sq-2 9s ease-in-out infinite 3s;
  }

  /* Small accent squares */
  .sh--pos-9 {
    top: 60%;
    left: 3%;
    opacity: 0.4;
    animation: wobble 9s ease-in-out infinite 2s;
    transform: rotate(-15deg);
  }

  .sh--pos-10 {
    top: 10%;
    left: 50%;
    opacity: 0.5;
    animation: pop 6s ease-in-out infinite 1s;
  }

  .sh--pos-11 {
    bottom: 30%;
    right: 4%;
    opacity: 0.45;
    animation: pop 5s ease-in-out infinite 2.5s;
  }

  /* --- DOTS --- */
  .sh--pos-d1 { top: 18%; left: 12%; opacity: 0.35; animation: pop 4s ease-in-out infinite; }
  .sh--pos-d2 { top: 45%; right: 10%; opacity: 0.3; animation: pop 5s ease-in-out infinite 1s; }
  .sh--pos-d3 { bottom: 20%; left: 30%; opacity: 0.25; animation: pop 4.5s ease-in-out infinite 0.5s; }
  .sh--pos-d4 { top: 75%; right: 35%; opacity: 0.35; animation: pop 3.5s ease-in-out infinite 2s; }
  .sh--pos-d5 { bottom: 8%; right: 50%; opacity: 0.3; animation: pop 5.5s ease-in-out infinite 1.5s; }

  /* --- SYMBOLS --- */
  .sh--pos-s1 { top: 12%; right: 18%; font-size: 1.3rem; color: var(--coral); opacity: 0.5; animation: float-sym 5s ease-in-out infinite; }
  .sh--pos-s2 { bottom: 25%; left: 18%; font-size: 1rem; color: var(--violet); opacity: 0.4; animation: float-sym 6s ease-in-out infinite 1s; }
  .sh--pos-s3 { top: 50%; left: 6%; font-size: 1.6rem; color: var(--ink); opacity: 0.08; animation: float-sym 7s ease-in-out infinite 0.5s; }

  /* ===== ANIMATIONS ===== */
  @keyframes drift-sq-1 {
    0%, 100% { transform: rotate(-8deg) translate(0, 0); }
    25% { transform: rotate(-6deg) translate(10px, -15px); }
    50% { transform: rotate(-10deg) translate(-5px, -25px); }
    75% { transform: rotate(-7deg) translate(12px, -8px); }
  }

  @keyframes drift-sq-2 {
    0%, 100% { transform: rotate(5deg) translate(0, 0); }
    33% { transform: rotate(8deg) translate(-15px, 12px); }
    66% { transform: rotate(3deg) translate(8px, -18px); }
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes wobble {
    0%, 100% { transform: rotate(12deg) translate(0, 0); }
    25% { transform: rotate(16deg) translate(5px, -8px); }
    50% { transform: rotate(8deg) translate(-5px, 5px); }
    75% { transform: rotate(14deg) translate(8px, 3px); }
  }

  @keyframes pop {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }

  @keyframes float-sym {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(6deg); }
  }

  /* ===== SCROLL ===== */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .hero__scroll-line {
    width: 2px;
    height: 40px;
    background: var(--ink);
    opacity: 0.2;
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--coral);
    animation: scroll-down 2s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0% { top: -100%; }
    100% { top: 100%; }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero__text {
      text-align: center;
      order: 1;
    }

    .hero__visuals {
      order: 2;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__keywords {
      justify-content: center;
    }

    .hero__img-frame--main {
      max-width: 300px;
      margin: 0 auto;
    }

    .hero__img-frame--bottom {
      max-width: 300px;
      margin: 0 auto;
    }

    .hero__img-deco--1 {
      width: 45px;
      height: 45px;
      top: -12px;
      right: 10%;
    }

    .hero__img-deco--2 {
      width: 30px;
      height: 30px;
      bottom: 60px;
      left: 5%;
    }

    .hero__img-deco--3 {
      width: 22px;
      height: 22px;
    }

    .sh--huge { width: 180px; height: 180px; }
    .sh--xxl { width: 140px; height: 140px; }
    .sh--xl { width: 110px; height: 110px; }
    .sh--lg { width: 80px; height: 80px; }
    .sh--md { width: 55px; height: 55px; }
    .sh--sm { width: 35px; height: 35px; }
  }

  @media (max-width: 480px) {
    .hero__name {
      font-size: clamp(2.8rem, 14vw, 4rem);
    }

    .hero__img-frame--main {
      max-width: 260px;
    }

    .hero__img-frame--bottom {
      max-width: 260px;
    }
  }
</style>
