---

---

<section class="hero" id="home">
  <!-- Large background art shapes -->
  <div class="hero__bg-art" aria-hidden="true">
    <!-- Large ring -->
    <div class="bg-ring bg-ring--1"></div>
    <!-- Big soft circle -->
    <div class="bg-circle bg-circle--1"></div>
    <!-- Half circle bleeding off edge -->
    <div class="bg-half bg-half--1"></div>
    <!-- Small accent circle -->
    <div class="bg-dot bg-dot--1"></div>
    <div class="bg-dot bg-dot--2"></div>
    <!-- Large arc -->
    <div class="bg-ring bg-ring--2"></div>
    <!-- Abstract blob -->
    <div class="bg-circle bg-circle--2"></div>
  </div>

  <!-- Small floating accents -->
  <div class="hero__accents" aria-hidden="true">
    <span class="accent accent--1">✦</span>
    <span class="accent accent--2">●</span>
    <span class="accent accent--3">✦</span>
    <span class="accent accent--4">○</span>
  </div>

  <div class="hero__content container">
    <h1 class="hero__title">
      <span class="hero__title-line">S<span class="hero__o">O</span>MA</span>
    </h1>

    <p class="hero__tagline">
      Cuerpo, arte<br class="mobile-br" /> y encuentro.
    </p>

    <p class="hero__desc">
      Un espacio vivo donde la creatividad se comparte.
    </p>

    <div class="hero__actions">
      <a href="#events" class="btn btn--coral">Ver agenda →</a>
      <a href="#about" class="btn btn--outline">Descubre Soma</a>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
  }

  .hero__content {
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .hero__title {
    font-size: clamp(5rem, 18vw, 14rem);
    letter-spacing: 0.04em;
    line-height: 0.9;
    margin-bottom: 1.5rem;
    position: relative;
  }

  .hero__o {
    color: var(--coral);
    display: inline-block;
    animation: wiggle 3s ease-in-out infinite;
  }

  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-3deg); }
    75% { transform: rotate(3deg); }
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 4vw, 2.8rem);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero__desc {
    font-size: clamp(1rem, 2vw, 1.3rem);
    opacity: 0.65;
    margin-bottom: 2.5rem;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== LARGE BACKGROUND ART ===== */
  .hero__bg-art {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* Big hollow ring */
  .bg-ring {
    position: absolute;
    border-radius: 50%;
    border: 3px solid;
  }

  .bg-ring--1 {
    width: 420px;
    height: 420px;
    border-color: var(--coral);
    opacity: 0.12;
    top: -80px;
    right: -100px;
    animation: spin-slow 40s linear infinite;
  }

  .bg-ring--2 {
    width: 280px;
    height: 280px;
    border-color: var(--violet);
    opacity: 0.1;
    bottom: 5%;
    left: -60px;
    border-style: dashed;
    animation: spin-slow 60s linear infinite reverse;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Soft filled circles */
  .bg-circle {
    position: absolute;
    border-radius: 50%;
  }

  .bg-circle--1 {
    width: 340px;
    height: 340px;
    background: var(--violet);
    opacity: 0.06;
    top: 10%;
    left: -120px;
  }

  .bg-circle--2 {
    width: 200px;
    height: 200px;
    background: var(--yellow);
    opacity: 0.08;
    bottom: 8%;
    right: 5%;
  }

  /* Half circle bleeding off screen */
  .bg-half {
    position: absolute;
  }

  .bg-half--1 {
    width: 300px;
    height: 150px;
    background: var(--coral);
    opacity: 0.07;
    border-radius: 300px 300px 0 0;
    bottom: 0;
    left: 15%;
  }

  /* Small colored dots */
  .bg-dot {
    position: absolute;
    border-radius: 50%;
  }

  .bg-dot--1 {
    width: 18px;
    height: 18px;
    background: var(--coral);
    top: 22%;
    right: 20%;
  }

  .bg-dot--2 {
    width: 12px;
    height: 12px;
    background: var(--blue);
    bottom: 30%;
    left: 18%;
  }

  /* ===== SMALL FLOATING ACCENTS ===== */
  .hero__accents {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .accent {
    position: absolute;
    font-family: var(--font-display);
    animation: float 5s ease-in-out infinite;
  }

  .accent--1 {
    top: 18%;
    left: 12%;
    font-size: 1.2rem;
    color: var(--coral);
    animation-delay: 0s;
  }

  .accent--2 {
    top: 25%;
    right: 12%;
    font-size: 0.8rem;
    color: var(--violet);
    opacity: 0.5;
    animation-delay: 1s;
  }

  .accent--3 {
    bottom: 28%;
    right: 15%;
    font-size: 1rem;
    color: var(--blue);
    opacity: 0.6;
    animation-delay: 2s;
  }

  .accent--4 {
    bottom: 22%;
    left: 10%;
    font-size: 1.5rem;
    color: var(--ink);
    opacity: 0.15;
    animation-delay: 0.5s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Scroll indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .hero__scroll-line {
    width: 2px;
    height: 40px;
    background: var(--ink);
    opacity: 0.25;
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--coral);
    animation: scroll-down 2s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0% { top: -100%; }
    100% { top: 100%; }
  }

  .mobile-br {
    display: none;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 4rem;
    }

    .mobile-br {
      display: block;
    }

    .bg-ring--1 {
      width: 250px;
      height: 250px;
      top: -50px;
      right: -80px;
    }

    .bg-ring--2 {
      width: 180px;
      height: 180px;
    }

    .bg-circle--1 {
      width: 200px;
      height: 200px;
    }

    .bg-circle--2 {
      width: 120px;
      height: 120px;
    }

    .bg-half--1 {
      width: 180px;
      height: 90px;
    }
  }
</style>
