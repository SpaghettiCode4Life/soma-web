---
const links = [
  { href: '#about', label: 'Soma' },
  { href: '#gallery', label: 'Galería' },
  { href: '#events', label: 'Agenda' },
  { href: '#booking', label: 'Espacio' },
];
---

<nav class="navbar" id="navbar">
  <div class="navbar__inner container">
    <a href="#" class="navbar__logo" aria-label="Soma">
      <svg class="navbar__logo-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect class="logo-bg" x="1.5" y="1.5" width="61" height="61" rx="12" fill="#FFFBF4" stroke="#1A1A2E" stroke-width="3"/>
        <text x="32" y="44" text-anchor="middle" font-family="'Space Grotesk', Arial Black, sans-serif" font-weight="900" font-size="30" fill="#FF5C38" letter-spacing="1">S</text>
        <circle class="logo-dot" cx="50" cy="14" r="5" fill="#BFFF00" stroke="#1A1A2E" stroke-width="1.5"/>
      </svg>
    </a>

    <button class="navbar__toggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="navbar__links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.querySelector('.navbar__toggle');
  const nav = document.querySelector('.navbar');
  const links = document.querySelectorAll('.navbar__links a');

  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
  });

  links.forEach((link) => {
    link.addEventListener('click', () => {
      nav?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    if (window.scrollY > 60) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  });
</script>

<style>
  /* ===== BASE (mobile-first): transparent, ink text ===== */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1.25rem 0;
    transition: all 0.35s ease;
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar__logo {
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, opacity 0.2s;
  }

  .navbar__logo:hover {
    transform: scale(1.05);
  }

  .navbar__logo-icon {
    width: 40px;
    height: 40px;
    display: block;
  }

  .logo-bg,
  .logo-dot {
    transition: fill 0.35s ease, stroke 0.35s ease;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }

  .navbar__links a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.35s ease;
  }

  .navbar__links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2.5px;
    background: var(--coral);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navbar__links a:hover::after {
    width: 100%;
  }

  /* Mobile toggle */
  .navbar__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 10;
  }

  .navbar__toggle span {
    display: block;
    width: 26px;
    height: 2.5px;
    background: var(--ink);
    transition: all 0.3s ease;
  }

  /* ===== SCROLLED (all sizes): cream bg, ink text ===== */
  .navbar.scrolled {
    background: rgba(255, 251, 244, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.8rem 0;
    border-bottom: var(--border-thin);
    color: var(--ink);
  }

  .navbar.scrolled .navbar__links a {
    color: var(--ink);
  }

  .navbar.scrolled .navbar__toggle span {
    background: var(--ink);
  }

  /* Logo on scroll: cream bg, ink stroke (default SVG values) */
  .navbar.scrolled .logo-bg {
    fill: #FFFBF4;
    stroke: #1A1A2E;
  }

  .navbar.scrolled .logo-dot {
    stroke: #1A1A2E;
  }

  /* ===== DESKTOP: dark navbar when NOT scrolled ===== */
  @media (min-width: 769px) {
    .navbar:not(.scrolled) {
      background: var(--ink);
      color: var(--cream);
    }

    .navbar:not(.scrolled) .navbar__links a {
      color: var(--cream);
    }

    /* Logo on dark bg: ink fill, cream stroke */
    .navbar:not(.scrolled) .logo-bg {
      fill: #1A1A2E;
      stroke: #FFFBF4;
    }

    .navbar:not(.scrolled) .logo-dot {
      stroke: #FFFBF4;
    }
  }

  /* ===== MOBILE ===== */
  @media (max-width: 768px) {
    .navbar__toggle {
      display: flex;
    }

    .navbar__links {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 2.5rem;
      background: var(--ink);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .navbar__links a {
      font-size: 1.6rem;
      color: var(--cream) !important;
    }

    .navbar.open .navbar__links {
      opacity: 1;
      pointer-events: all;
    }

    .navbar.open .navbar__toggle span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .navbar.open .navbar__toggle span:nth-child(2) {
      opacity: 0;
    }

    .navbar.open .navbar__toggle span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }
  }
</style>
