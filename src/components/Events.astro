---
const events = [
  {
    date: '22',
    month: 'Feb',
    day: 'Sábado',
    time: '11:00 — 14:00',
    title: 'Taller de movimiento expresivo',
    description: 'Exploración del cuerpo a través de la improvisación y el juego.',
    tag: 'movimiento',
    tagColor: 'coral',
    color: '#FF5C38',
  },
  {
    date: '01',
    month: 'Mar',
    day: 'Domingo',
    time: '17:00 — 20:00',
    title: 'Sesión abierta de dibujo',
    description: 'Dibujamos juntxs. Trae tus materiales o usa los del espacio.',
    tag: 'arte',
    tagColor: 'violet',
    color: '#9B5DE5',
  },
  {
    date: '13',
    month: 'Mar',
    day: 'Viernes',
    time: '19:00 — 21:30',
    title: 'Encuentro: cuerpo y espacio',
    description: 'Una conversación abierta sobre habitar, moverse y crear en comunidad.',
    tag: 'encuentro',
    tagColor: 'blue',
    color: '#3D5AFF',
  },
  {
    date: '28',
    month: 'Mar',
    day: 'Sábado',
    time: '10:00 — 18:00',
    title: 'Jornada de creación colectiva',
    description: 'Un día completo para explorar, crear y compartir procesos.',
    tag: 'taller',
    tagColor: 'yellow',
    color: '#FFD166',
  },
];
---

<section class="events" id="events">
  <!-- Background art -->
  <div class="events__bg" aria-hidden="true">
    <div class="events__bg-circle"></div>
    <div class="events__bg-ring"></div>
    <div class="events__bg-dot"></div>
    <div class="events__bg-dot events__bg-dot--2"></div>
  </div>

  <div class="container">
    <div class="events__header reveal">
      <h2 class="section-title">Próximamente</h2>
      <p class="section-subtitle">
        Lo que viene en Soma. Plazas limitadas, corazones abiertos.
      </p>
    </div>

    <div class="events__list">
      {events.map((event, i) => (
        <article class={`event-card reveal reveal-delay-${(i % 4) + 1}`} style={`--card-color: ${event.color}`}>
          <div class="event-card__date">
            <span class="event-card__date-number">{event.date}</span>
            <span class="event-card__date-month">{event.month}</span>
          </div>

          <div class="event-card__body">
            <div class="event-card__meta">
              <span class="event-card__day">{event.day}</span>
              <span class="event-card__time">{event.time}</span>
            </div>
            <h3 class="event-card__title">{event.title}</h3>
            <p class="event-card__desc">{event.description}</p>
            <div class="event-card__footer">
              <span class={`tag tag--${event.tagColor}`}>{event.tag}</span>
              <a href="#" class="event-card__link">Reservar plaza →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="events__cta reveal">
      <a href="#" class="btn btn--violet">Ver toda la agenda →</a>
    </div>
  </div>
</section>

<style>
  .events {
    background: var(--cream);
    position: relative;
  }

  /* Background art */
  .events__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .events__bg-circle {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: var(--blue);
    opacity: 0.04;
    top: 10%;
    right: -80px;
  }

  .events__bg-ring {
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    border: 2.5px solid var(--coral);
    opacity: 0.07;
    bottom: 5%;
    left: -60px;
    animation: spin-slow 50s linear infinite;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .events__bg-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--violet);
    top: 20%;
    left: 8%;
    opacity: 0.4;
  }

  .events__bg-dot--2 {
    width: 8px;
    height: 8px;
    background: var(--coral);
    top: auto;
    bottom: 15%;
    left: auto;
    right: 10%;
    opacity: 0.5;
  }

  .events__header {
    margin-bottom: 3.5rem;
    position: relative;
    z-index: 1;
  }

  .events__list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .event-card {
    display: flex;
    gap: 2rem;
    background: #fff;
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.8rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .event-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 5px;
    height: 100%;
    background: var(--card-color);
  }

  .event-card:hover {
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-sm);
  }

  .event-card__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    text-align: center;
    border-right: var(--border-thin);
    padding-right: 1.8rem;
  }

  .event-card__date-number {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--card-color);
  }

  .event-card__date-month {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  .event-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .event-card__meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    opacity: 0.55;
    font-weight: 500;
  }

  .event-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .event-card__desc {
    font-size: 0.9rem;
    opacity: 0.65;
    max-width: 480px;
  }

  .event-card__footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.4rem;
    flex-wrap: wrap;
  }

  .event-card__link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--card-color);
    transition: opacity 0.2s;
    margin-left: auto;
  }

  .event-card__link:hover {
    opacity: 0.7;
  }

  .events__cta {
    text-align: center;
    margin-top: 3rem;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .event-card {
      flex-direction: column;
      gap: 1rem;
      padding: 1.4rem;
    }

    .event-card__date {
      flex-direction: row;
      gap: 0.5rem;
      border-right: none;
      border-bottom: var(--border-thin);
      padding-right: 0;
      padding-bottom: 1rem;
      justify-content: flex-start;
    }

    .event-card__date-number {
      font-size: 1.8rem;
    }

    .event-card__date-month {
      align-self: flex-end;
      padding-bottom: 0.15rem;
    }

    .event-card__link {
      margin-left: 0;
    }
  }
</style>
