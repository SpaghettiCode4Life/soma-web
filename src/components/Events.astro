---
const events = [
  {
    date: '15',
    month_es: 'Mar',
    month_en: 'Mar',
    year: '2026',
    title_es: 'Sesión de relajación con música experimental y visuales',
    title_en: 'Relaxation session with experimental music & visuals',
    description_es:
      'Una experiencia inmersiva que combina música experimental, visuales proyectados y relajación guiada. Déjate llevar por los sonidos y las imágenes en un espacio seguro y acogedor.',
    description_en:
      'An immersive experience combining experimental music, projected visuals, and guided relaxation. Let yourself be carried by sounds and images in a safe, welcoming space.',
    tag_es: 'Experiencia',
    tag_en: 'Experience',
    color: 'green',
  },
  {
    date: '22',
    month_es: 'Mar',
    month_en: 'Mar',
    year: '2026',
    title_es: 'Taller de terapia holística',
    title_en: 'Holistic therapy workshop',
    description_es:
      'Explora prácticas de sanación holística en un entorno de apoyo y confianza. Conecta con tu cuerpo, mente y espíritu a través de técnicas ancestrales y contemporáneas.',
    description_en:
      'Explore holistic healing practices in a supportive, trusting environment. Connect with your body, mind, and spirit through ancestral and contemporary techniques.',
    tag_es: 'Taller',
    tag_en: 'Workshop',
    color: 'terracotta',
  },
  {
    date: '5',
    month_es: 'Abr',
    month_en: 'Apr',
    year: '2026',
    title_es: 'Descubre artistas de la zona — Exposición colectiva',
    title_en: 'Discover local artists — Collective exhibition',
    description_es:
      'Una tarde dedicada a conocer artistas locales y su obra. Exposición, conversación y conexión en un ambiente íntimo y cercano. Ven a descubrir el talento de tu barrio.',
    description_en:
      'An afternoon dedicated to discovering local artists and their work. Exhibition, conversation, and connection in an intimate setting. Come discover the talent in your neighborhood.',
    tag_es: 'Evento',
    tag_en: 'Event',
    color: 'yellow',
  },
];
---

<section id="events">
  <div class="container">
    <div class="events-header">
      <span class="section-label reveal">
        <span class="lang-es">Agenda</span>
        <span class="lang-en">Schedule</span>
      </span>
      <h2 class="section-title reveal reveal-delay-1">
        <span class="lang-es">Próximos eventos</span>
        <span class="lang-en">Upcoming events</span>
      </h2>
      <p class="section-subtitle reveal reveal-delay-2">
        <span class="lang-es">Talleres, sesiones y encuentros para explorar, crear y conectar.</span>
        <span class="lang-en">Workshops, sessions, and gatherings to explore, create, and connect.</span>
      </p>
    </div>

    <div class="events-grid">
      {
        events.map((event, i) => (
          <article class={`event-card reveal reveal-delay-${i + 1}`}>
            <div class="event-date-block">
              <span class="event-day">{event.date}</span>
              <span class="event-month">
                <span class="lang-es">{event.month_es}</span>
                <span class="lang-en">{event.month_en}</span>
              </span>
              <span class="event-year">{event.year}</span>
            </div>

            <div class="event-body">
              <div class="event-tag-row">
                <span class={`event-tag tag-${event.color}`}>
                  <span class="lang-es">{event.tag_es}</span>
                  <span class="lang-en">{event.tag_en}</span>
                </span>
              </div>

              <h3 class="event-title">
                <span class="lang-es">{event.title_es}</span>
                <span class="lang-en">{event.title_en}</span>
              </h3>

              <p class="event-description">
                <span class="lang-es">{event.description_es}</span>
                <span class="lang-en">{event.description_en}</span>
              </p>

              <a href="#contact" class="event-link">
                <span class="lang-es">Más información →</span>
                <span class="lang-en">More info →</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  #events {
    background: var(--cream);
  }

  .events-header {
    margin-bottom: 3.5rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* ===== Event Card ===== */
  .event-card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.06),
      0 2px 8px rgba(0, 0, 0, 0.04);
  }

  /* Date block */
  .event-date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 64px;
    padding: 0.75rem 0;
    border-radius: var(--radius-sm);
    background: var(--cream);
    flex-shrink: 0;
  }

  .event-day {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--green-dark);
  }

  .event-month {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--green);
    margin-top: 0.15rem;
  }

  .event-year {
    font-size: 0.7rem;
    color: var(--text-light);
    margin-top: 0.1rem;
  }

  /* Event body */
  .event-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .event-tag-row {
    margin-bottom: 0.75rem;
  }

  .event-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
  }

  .tag-green {
    background: rgba(74, 124, 89, 0.12);
    color: var(--green);
  }

  .tag-terracotta {
    background: rgba(200, 120, 91, 0.12);
    color: var(--terracotta);
  }

  .tag-yellow {
    background: rgba(232, 197, 71, 0.18);
    color: #a08520;
  }

  .event-title {
    font-size: 1.25rem;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .event-description {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.65;
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .event-link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--green);
    transition: color 0.2s ease;
    display: inline-block;
  }

  .event-link:hover {
    color: var(--green-dark);
  }

  @media (max-width: 1024px) {
    .events-grid {
      grid-template-columns: 1fr;
      max-width: 600px;
    }

    .event-card {
      flex-direction: row;
      align-items: start;
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .event-card {
      flex-direction: column;
    }

    .event-date-block {
      flex-direction: row;
      width: auto;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
    }
  }
</style>

