<section id="contact">
  <div class="container">
    <div class="contact-header">
      <span class="section-label reveal">
        <span class="lang-es">Contacto</span>
        <span class="lang-en">Contact</span>
      </span>
      <h2 class="contact-title reveal reveal-delay-1">
        <span class="lang-es">Hablemos</span>
        <span class="lang-en">Let's talk</span>
      </h2>
      <p class="contact-subtitle reveal reveal-delay-2">
        <span class="lang-es">¿Quieres proponer un taller, reservar nuestro espacio o simplemente saber más sobre Soma?</span>
        <span class="lang-en">Want to propose a workshop, book our space, or simply learn more about Soma?</span>
      </p>
    </div>

    <div class="contact-grid">
      <!-- Left: Info cards -->
      <div class="contact-info-col">
        <div class="info-card reveal">
          <div class="info-card-icon icon-email">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </div>
          <div class="info-card-text">
            <h4>Email</h4>
            <p>hola@soma.space</p>
          </div>
        </div>

        <div class="info-card reveal reveal-delay-1">
          <div class="info-card-icon icon-location">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <div class="info-card-text">
            <h4>
              <span class="lang-es">Ubicación</span>
              <span class="lang-en">Location</span>
            </h4>
            <p>Barcelona, Spain</p>
          </div>
        </div>

        <div class="info-card reveal reveal-delay-2">
          <div class="info-card-icon icon-calendar">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </div>
          <div class="info-card-text">
            <h4>
              <span class="lang-es">Disponibilidad</span>
              <span class="lang-en">Availability</span>
            </h4>
            <p>
              <span class="lang-es">Abierto para eventos y talleres</span>
              <span class="lang-en">Open for events and workshops</span>
            </p>
          </div>
        </div>

        <div class="social-row reveal reveal-delay-3">
          <a href="#" class="social-link" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
            <span>Instagram</span>
          </a>
          <a href="#" class="social-link" aria-label="Telegram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13" />
              <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
            <span>Telegram</span>
          </a>
        </div>
      </div>

      <!-- Right: Form card -->
      <div class="form-card reveal reveal-delay-1">
        <h3 class="form-card-title">
          <span class="lang-es">Envíanos un mensaje</span>
          <span class="lang-en">Send us a message</span>
        </h3>

        <form id="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">
                <span class="lang-es">Nombre</span>
                <span class="lang-en">Name</span>
              </label>
              <input type="text" id="name" name="name" required autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
          </div>

          <div class="form-group">
            <label for="subject">
              <span class="lang-es">Asunto</span>
              <span class="lang-en">Subject</span>
            </label>
            <select id="subject" name="subject" required>
              <option value="" disabled selected>—</option>
              <option value="workshop">Proponer un taller / Propose a workshop</option>
              <option value="booking">Reservar el espacio / Book the space</option>
              <option value="info">Información general / General inquiry</option>
              <option value="other">Otro / Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">
              <span class="lang-es">Mensaje</span>
              <span class="lang-en">Message</span>
            </label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" class="form-submit">
            <span class="lang-es">Enviar mensaje</span>
            <span class="lang-en">Send message</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </button>
        </form>

        <div id="form-success" class="form-success">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
          <div>
            <strong>
              <span class="lang-es">¡Mensaje enviado!</span>
              <span class="lang-en">Message sent!</span>
            </strong>
            <p>
              <span class="lang-es">Gracias por escribirnos. Te responderemos lo antes posible.</span>
              <span class="lang-en">Thanks for reaching out. We'll get back to you as soon as possible.</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    contactForm.style.display = 'none';
    if (successMsg) {
      successMsg.classList.add('show');
    }
  });
</script>

<style>
